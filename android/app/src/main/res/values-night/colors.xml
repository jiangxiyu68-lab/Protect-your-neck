<?xml version="1.0" encoding="utf-8"?>
<!--
  深色配色（v1.5）：与 values/colors.xml 一一对应，切换深色时整包生效。
  这是 App 一直以来的观感（深底深卡 + 浅字），所以「深色」是默认档。
-->
<resources>
    <color name="bg">#0F1216</color>
    <color name="surface">#171C22</color>
    <color name="surface_alt">#222A33</color>
    <color name="stroke">#2C3540</color>

    <color name="text">#ECF1F6</color>
    <color name="text_dim">#93A1B0</color>
    <color name="text_faint">#5F6C7A</color>

    <color name="accent">#2E7DF6</color>
    <color name="accent_dim">#1E5FC0</color>
    <color name="white">#FFFFFF</color>
    <color name="chip_text">#0F1216</color>

    <color name="safe">#34C759</color>
    <color name="warn">#FFB020</color>
    <color name="danger">#FF453A</color>

    <!-- 周报图表（自绘） -->
    <color name="chart_bg">#1B1B1B</color>
    <color name="chart_grid">#3A3A3A</color>
    <color name="chart_text">#ECECEC</color>
    <color name="chart_text_dim">#8A8A8A</color>

    <!-- 放松操圆环（自绘） -->
    <color name="ring_track">#2C3540</color>
    <color name="ring_text">#ECF1F6</color>
    <color name="ring_text_dim">#93A1B0</color>
    <!-- 导航栏固定深色：EMUI 忽略 windowLightNavigationBar，白底会让图标看不见 -->
    <color name="nav_bar">#0F1216</color>
</resources>
