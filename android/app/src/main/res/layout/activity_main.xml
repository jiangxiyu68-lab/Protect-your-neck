<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 可滚动内容：按钮固定在底部，内容在小屏/横屏/大字体下不会被挤掉 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="122dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="颈椎守护"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="健康提醒 · 非医疗诊断"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <!-- 状态：胶囊 + 说明 -->
            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/levelChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="14dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="5dp"
                    android:text="待机"
                    android:textColor="@color/chip_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="点击下方「开始守护」"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/fpsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="-- fps"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 画面 + 实时指标并排：画面是竖幅 3:4，单独占一行会左右留黑边 -->
            <LinearLayout
                android:id="@+id/cardRow"
                android:layout_width="match_parent"
                android:layout_height="216dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- 画面卡：相机由前台服务独占，这里只把自己的 Surface 交给服务的 Preview 用例 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="56"
                    android:background="@drawable/bg_preview">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="invisible"
                        app:implementationMode="compatible"
                        app:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/previewHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="画面未开启\n点「开始守护」后在此显示"
                        android:textColor="@color/text_faint"
                        android:textSize="12sp" />

                    <!-- 识别标注：把算法实际用到的耳/肩、CVA 连线与夹角画在画面上 -->
                    <com.example.cervicalguard.ui.LandmarkOverlayView
                        android:id="@+id/overlayView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- 吉祥物：叠在画面右下角，表情跟着坐姿实时变（设计见 吉祥物-颈颈鹿设计.md）
                         放右下不挡左下的人脸区域；底部读数条也避开了它所在的角落。 -->
                    <com.example.cervicalguard.ui.MascotView
                        android:id="@+id/mascot"
                        android:layout_width="46dp"
                        android:layout_height="62dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp" />
                </FrameLayout>

                <!-- 实时指标 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="44"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        style="@style/Cg.Metric.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CVA 颅颈角" />

                    <TextView
                        android:id="@+id/cvaText"
                        style="@style/Cg.Metric.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/stroke" />

                    <TextView
                        style="@style/Cg.Metric.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="头前倾角" />

                    <TextView
                        android:id="@+id/forwardText"
                        style="@style/Cg.Metric.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/stroke" />

                    <TextView
                        style="@style/Cg.Metric.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="等效负荷" />

                    <TextView
                        android:id="@+id/loadText"
                        style="@style/Cg.Metric.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--" />
                </LinearLayout>
            </LinearLayout>

            <!-- 今日统计 -->
            <LinearLayout
                android:id="@+id/todayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Cg.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="今日守护" />

                        <TextView
                            android:id="@+id/statTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0分0秒"
                            android:textColor="@color/text_dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- 坐姿分做视觉主角：秒数/百分比不直观，单一分数才便于比较与看趋势 -->
                    <TextView
                        android:id="@+id/scoreValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/accent"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="分"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/scoreGrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 三级占比条：子 View 由代码按秒数设 weight -->
                <LinearLayout
                    android:id="@+id/proportionBar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_bar"
                    android:clipToOutline="true"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barSafe"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/safe" />

                    <View
                        android:id="@+id/barWarn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/warn" />

                    <View
                        android:id="@+id/barDanger"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/danger" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Cg.Metric.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="安全" />

                        <TextView
                            android:id="@+id/statSafe"
                            style="@style/Cg.Stat.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="0分0秒" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Cg.Metric.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="注意" />

                        <TextView
                            android:id="@+id/statWarn"
                            style="@style/Cg.Stat.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="0分0秒" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Cg.Metric.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="危险" />

                        <TextView
                            android:id="@+id/statDanger"
                            style="@style/Cg.Stat.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="0分0秒" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Cg.Metric.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="最大头前倾" />

                        <TextView
                            android:id="@+id/statMax"
                            style="@style/Cg.Stat.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="0.0°" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 成长条：吉祥物的「话」+ 等级 / 经验 / 连续天数。
                 原来这些只在后台攒，用户看不到进度——看不到的激励等于没有。
                 做成紧凑两行，避免把内容顶到折叠线以下（首版就被底部按钮栏压住了）。 -->
            <LinearLayout
                android:id="@+id/growthStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/speechText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="点「开始守护」，我们一起"
                        android:textColor="@color/text"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/levelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Lv.1"
                        android:textColor="@color/accent"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <!-- 积分余额（v1.2）：常驻显示，点一下进衣橱 -->
                    <TextView
                        android:id="@+id/coinText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_coin"
                        android:paddingStart="6dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="1dp"
                        android:text="积分 0"
                        android:textColor="@color/warn"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/streakText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text=""
                        android:textColor="@color/warn"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:clipToOutline="true"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/xpBarFill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0"
                            android:background="@color/accent" />

                        <View
                            android:id="@+id/xpBarRest"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/xpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="再攒 100 分升级"
                        android:textColor="@color/text_faint"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部固定操作区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsBtn"
                style="@style/Cg.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置" />

            <Button
                android:id="@+id/relaxBtn"
                style="@style/Cg.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="放松" />

            <!-- 衣橱入口（v1.2 激励模式）：放中间偏左，和「放松」都属于"陪小鹿玩"的动作 -->
            <Button
                android:id="@+id/wardrobeBtn"
                style="@style/Cg.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="衣橱" />

            <Button
                android:id="@+id/dataBtn"
                style="@style/Cg.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="数据" />

            <Button
                android:id="@+id/exportBtn"
                style="@style/Cg.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="导出" />
        </LinearLayout>

        <Button
            android:id="@+id/toggleBtn"
            style="@style/Cg.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开始守护" />
    </LinearLayout>

</FrameLayout>
