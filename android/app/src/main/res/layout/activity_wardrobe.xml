<?xml version="1.0" encoding="utf-8"?>
<!--
  小鹿衣橱（v1.2 激励模式）。

  结构固定为三段：顶部栏（返回 / 标题 / 积分）→ 吉祥物大图预览 → 时装列表。
  时装行不写在 XML 里，由 WardrobeActivity 按 Outfits.sorted() 动态生成：
  这样「价格、稀有度、三态按钮」只维护一份数据源，改时装目录不用同步改布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部栏：返回 + 标题 + 积分余额（余额用 warn 金色，和「积分」语义一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="返回"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="小鹿衣橱"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/coinText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="积分 0"
            android:textColor="@color/warn"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 吉祥物大图预览：纯色卡片，showBackdrop 在代码里设为 false -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <com.example.cervicalguard.ui.MascotView
                    android:id="@+id/mascot"
                    android:layout_width="140dp"
                    android:layout_height="190dp" />

                <TextView
                    android:id="@+id/equippedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="未穿时装 · 显示等级配饰"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="点下方列表试穿，攒积分解锁更多"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 列表标题行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Cg.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时装" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/ownedCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已拥有 0/8"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="每 60 秒安全坐姿 +1 积分 · 完成放松操 +5"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <!-- 时装行由代码生成，避免 8 段重复 XML -->
            <LinearLayout
                android:id="@+id/outfitList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
